# gks 示例配置（服务端与客户端读同一份文件）
#
# 三段式：
#   common: 两端必须一致的参数（PSK、加密算法、KCP 调参、流与帧上限）—— 只写一次
#   client: 仅客户端使用的参数
#   server: 仅服务端使用的参数
#
# 两个程序读同一个文件，各取自己需要的段落：
#   ./bin/server -c gks.yaml
#   ./bin/client -c gks.yaml
#
# 注意：
#   1. common.psk 是 base64 编码的 32 字节密钥，两端共用同一份，不存在写岔的可能。
#      生成：openssl rand -base64 32
#      下面是示例占位值（0x00..0x1f），上线前必须替换。
#   2. common.crypt / common.aead 同理，两端天然一致。
#   3. 未知字段会导致启动失败（严格模式）；把 common 的字段写进 client/server 也会报错。

common:
  psk: "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="
  crypt: "none"                      # none（默认）| aes-128-gcm | aes-256-gcm | aes-128 | aes-256 | salsa20
                                     # 开启后连 KCP 头也被加密（隐藏协议指纹），每包多 28B 开销
  aead: "chacha20-poly1305"          # chacha20-poly1305 | aes-256-gcm
  kcp:
    interval: 10ms                   # 刷新间隔
    mtu: 1350                        # 避免 IP 分片
    sndwnd: 256                      # 发送窗口
    rcvwnd: 256                      # 接收窗口
    data_shards: 10                  # FEC：10 数据 + 3 校验（0 = 关闭）
    parity_shards: 3                 # 丢包链路建议开启（线开销约 +30%，换来免重传的低抖动）
  stream:
    idle_timeout: 600s               # 流长时间无数据则 RST
  limits:
    max_streams_per_session: 256     # 客户端开流上限 = 服务端接受上限
    max_frame_body: 65536            # 超过即断开（防伪造长度挂起）
    max_data_payload: 16384          # 发送方据此拆帧
  metrics_interval: 10s              # 传输统计采样间隔（B/s、线速率、重传率），0 = 关闭

client:
  listen: "127.0.0.1:2080"           # 本地 SOCKS5 TCP 监听
  auth:
    mode: "none"                     # 当前仅支持 none（userpass 未实现，写 userpass 会启动失败）
    users: []
  socks5:
    handshake_timeout: 10s           # 方法协商 + 请求解析
    connect_timeout: 10s             # 等待服务端 CONNECT_RESP
  pool:
    size: 2                          # 初始/保底 Session 数
    max_sessions: 64                 # Session 数硬上限 = 并发连接上限（每条会话同时 1 条流）
    idle_timeout: 300s               # 空闲 Session 回收
    startup_jitter: 300ms            # 启动错峰：相邻 Session 建立间隔随机
    connect_timeout: 5s              # 等待可用 Session 的上限
    backoff_min: 500ms               # 重建指数退避下限
    backoff_max: 30s                 # 重建指数退避上限
  kcp:
    server: "127.0.0.1:4000"         # 服务端 KCP/UDP 地址
    heartbeat_interval: 20s          # 实际在 15s~25s 间抖动
    heartbeat_miss: 3                # 连续未收到 PONG 的次数上限
    auth_timeout: 5s                 # 等待 AUTH_RESP
  shutdown_grace: 30s
  log:
    level: "info"                    # debug | info | warn | error

server:
  listen: "127.0.0.1:4000"           # KCP/UDP 监听
  auth:
    timestamp_window: 60s            # 允许的时钟偏差/重放窗口
    auth_timeout: 5s                 # 等待 AUTH_REQ
    replay_cache_size: 65536         # nonce 重放缓存条目上限
    max_pending_sessions: 1024       # 未认证 Session 并发上限
  dial:
    timeout: 10s
    keepalive: 30s
  shutdown_grace: 30s
  log:
    level: "info"
